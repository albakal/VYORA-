{
  "name": "vyora-cloud-functions",
  "version": "1.0.0",
  "description": "VYORA Firebase Cloud Functions v2 for Agora RTC tokens, server-side view rewards, withdrawals, and FCM notifications",
  "scripts": {
    "lint": "tsc --noEmit",
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "agora-token": "^2.0.5",
    "firebase-admin": "^13.2.0",
    "firebase-functions": "^6.3.2"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "private": true
}
