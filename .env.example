# GEMINI_API_KEY: Unused (VYORA does not embed client-side AI keys).
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# SUPABASE_URL: Your Supabase project base URL (e.g., https://xyzcompany.supabase.co).
# Enter the actual value in the AI Studio Secrets panel (never hardcode in source files).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# SUPABASE_PUBLISHABLE_KEY: Your Supabase public/publishable key protected by PostgreSQL RLS.
# Enter the actual value in the AI Studio Secrets panel (never hardcode in source files).
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Security Notice:
# - SUPABASE_SECRET_KEY and Agora secrets (AGORA_APP_ID, AGORA_APP_CERTIFICATE) MUST NEVER be added here
#   or packaged into the Android APK. Configure them strictly in Firebase Secret Manager for Cloud Functions.
